# Organization access token (access_…). Needs: payments.read/write,
# refunds.read/write, balances.read, profiles.read and sessions.write.
MOLLIE_ACCESS_TOKEN="your-organization-access-token"
NEXT_PUBLIC_MOLLIE_PROFILE="pfl_yourprofile"
DOMAIN="https://your-domain.com"
WEBHOOK_URL="htpps://your-domain.com/api"

# Google Auth for secret features
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
AUTH_SECRET="a-random-string-of-at-least-32-characters"